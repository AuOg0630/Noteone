<?xml version="1.0" encoding="utf-8"?>
<!--
  汇总模块（C）的字符串。前缀 report_*。

  与 strings_record.xml / strings_ledger.xml 同理：新建独立文件，不动 A 的 values/strings.xml。
  「支出 / 收入」直接复用 A 的 common_expense / common_income，不重复定义。
-->
<resources>

    <!-- 页头 -->
    <string name="report_title">汇总</string>
    <string name="report_export">导出</string>
    <string name="report_export_failed">导出失败</string>
    <string name="report_export_retry">重试</string>

    <!-- 时间范围 -->
    <string name="report_range_week">本周</string>
    <string name="report_range_month">本月</string>
    <string name="report_range_last3">近 3 月</string>
    <string name="report_range_year">今年</string>
    <string name="report_range_custom">自定义</string>

    <!-- 分类筛选 -->
    <string name="report_filter_all">全部</string>

    <!-- 三卡与日均 -->
    <string name="report_card_balance">结余</string>
    <string name="report_daily_average">日均支出</string>

    <!-- 本月预算进度（v1.6：从首页概览条搬到汇总页） -->
    <string name="report_budget_title">本月预算</string>
    <string name="report_budget_percent">已用 %1$d%%</string>
    <string name="report_budget_remaining">剩余</string>
    <string name="report_budget_over">超出</string>

    <!-- 分类排行 -->
    <string name="report_ranking_title">分类排行</string>
    <string name="report_ranking_other">其他</string>
    <string name="report_uncategorized">未分类</string>
    <string name="report_share_percent">%1$d%%</string>

    <!-- 趋势 -->
    <string name="report_trend_title">趋势</string>

    <!-- 自定义时间范围弹层 -->
    <string name="report_custom_title">自定义时间范围</string>
    <string name="report_custom_start">起始日</string>
    <string name="report_custom_end">结束日</string>
    <string name="report_custom_confirm">确定</string>
    <string name="report_custom_cancel">取消</string>
    <string name="report_date_year">年</string>
    <string name="report_date_month">月</string>
    <string name="report_date_day">日</string>

    <!-- 空状态 -->
    <string name="report_empty">该范围内没有记录</string>
</resources>
