<resources>

    <string name="onboarding_title">开启「记一笔」需要 2 项权限</string>
    <string name="onboarding_intro">「记一笔」磁贴会读取当前屏幕画面，认出金额后直接填进记账卡片。要做到这一点需要下面两项系统权限。两项都不授权也能正常记账，只是屏幕识别用不了。</string>

    <string name="onboarding_group_permission">权限</string>
    <string name="onboarding_overlay_note">框选金额的区域和记账面板都以悬浮窗显示，不授权就弹不出来。</string>
    <string name="onboarding_action_grant">去授权</string>

    <string name="onboarding_group_keepalive">建议</string>
    <string name="onboarding_keepalive_note">国产系统会在后台关掉无障碍服务，识别会突然失效。建议顺手加白名单并关闭电池优化。</string>

    <string name="onboarding_start">开始记账</string>
    <string name="onboarding_later_note">两项权限都可以稍后在「设置 → 磁贴与识别」里开启。</string>

</resources>
